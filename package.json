{
  "name": "note-stats",
  "displayName": "Note Stats",
  "description": "Word count and note helpers in the status bar. A sandbox extension whose issue tracker is seeded for testing issue-triage tooling.",
  "version": "0.1.0",
  "publisher": "egamma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/egamma/sweeper-sandbox"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "noteStats.toggle",
        "title": "Note Stats: Toggle Status Bar Item"
      },
      {
        "command": "noteStats.insertTimestamp",
        "title": "Note Stats: Insert Timestamp"
      },
      {
        "command": "noteStats.slugifyHeading",
        "title": "Note Stats: Slugify Current Line"
      }
    ],
    "configuration": {
      "title": "Note Stats",
      "properties": {
        "noteStats.showCharacters": {
          "type": "boolean",
          "default": false,
          "description": "Also show the character count next to the word count."
        },
        "noteStats.timestampFormat": {
          "type": "string",
          "enum": [
            "iso",
            "date",
            "datetime"
          ],
          "default": "iso",
          "description": "Format used by the Insert Timestamp command."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "tsc --noEmit -p .",
    "test": "tsc -p . && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
